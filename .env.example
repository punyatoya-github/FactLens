# Required
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Models (optional). Defaults are shown.
FACTLENS_CHAT_MODEL=gpt-6-luna
FACTLENS_EMBEDDING_MODEL=text-embedding-3-small

# Per-agent overrides (optional). Unset means "use FACTLENS_CHAT_MODEL".
# FACTLENS_SCOPE_MODEL=
# FACTLENS_SYNTHESIS_MODEL=gpt-6-sol
# FACTLENS_VERIFICATION_MODEL=
# Leave unset to use the model's default sampling; some models reject a custom temperature.
# FACTLENS_CHAT_TEMPERATURE=0

# PDF parsing (optional)
# auto  = parse without OCR, retry with OCR only if almost no text is found (default)
# never = fastest; scanned PDFs will come out empty
# always = OCR every image region (slowest)
# FACTLENS_OCR_MODE=auto

# Retrieval (optional)
# FACTLENS_VECTOR_SEARCH_K=10
# FACTLENS_BM25_SEARCH_K=4
# FACTLENS_HYBRID_WEIGHTS=[0.4,0.6]

# Pipeline (optional)
# FACTLENS_MAX_REVISIONS=2

# Server (optional)
# FACTLENS_SERVER_HOST=127.0.0.1
# FACTLENS_SERVER_PORT=7860
# FACTLENS_SHARE=false
